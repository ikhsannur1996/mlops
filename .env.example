# Copy to .env and adjust for your environment.
# docker-compose.yml already sets MLFLOW_TRACKING_URI and PREDICTION_DB for the api service.

# --- MLflow -----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --- API --------------------------------------------------------------------
PREDICTION_DB=predictions.db
# Cut-off that turns the predicted probability into a 0/1 decision. The 0.5
# default flags very few applicants at a 12% bad rate; use the threshold value
# logged by src/train.py (or the threshold analysis artifact in MLflow).
DECISION_THRESHOLD=0.5

# --- Dataset generation -----------------------------------------------------
DATA_DIR=data
N_TRAIN=8000
N_TEST=2000
RANDOM_SEED=42
# Realistic share of defaults the generator calibrates its risk model to.
TARGET_DEFAULT_RATE=0.12

# --- Training / evaluation --------------------------------------------------
TRAIN_DATA=data/train.csv
TEST_DATA=data/test.csv
REPORTS_DIR=reports

# --- Monitoring and retraining ----------------------------------------------
# Retraining is triggered only when the maximum feature PSI exceeds this value.
DRIFT_THRESHOLD=0.20
# Set to 1 to allow src/retrain.py to actually retrain after drift is detected.
AUTO_RETRAIN=0

# --- API simulation ---------------------------------------------------------
API_BASE_URL=http://localhost:8000
SIMULATION_REQUESTS=200
SIMULATION_WORKERS=4
# none | income | loan_amount | tenure | age | all
SIMULATION_DRIFT=none
