# Copy to .env and adjust for your environment.
# docker-compose.yml already sets MLFLOW_TRACKING_URI and PREDICTION_DB for the api service.

# --- MLflow -----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --- API --------------------------------------------------------------------
PREDICTION_DB=predictions.db

# --- Training / evaluation --------------------------------------------------
TRAIN_DATA=data/train.csv
REPORTS_DIR=reports

# --- Monitoring and retraining ----------------------------------------------
# Retraining is triggered only when the maximum feature PSI exceeds this value.
DRIFT_THRESHOLD=0.20
# Set to 1 to allow src/retrain.py to actually retrain after drift is detected.
AUTO_RETRAIN=0
